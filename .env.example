# SOPAT — variables d'environnement (modèle).
#
# Copier en .env et renseigner. Aucune valeur réelle ne doit être committée :
# .gitignore exclut .env*, et ce fichier ne contient que des noms de clés.
#
# Aucune des clés ci-dessous n'est préfixée NEXT_PUBLIC_ : tout ce qui l'est se
# retrouve dans le bundle navigateur, donc lisible par n'importe quel visiteur.

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=

# ── Session / authentification ────────────────────────────────────────────────
# 32 caractères minimum (contrôlé au démarrage).
SESSION_SECRET=
JWT_SECRET=

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Cloudinary (médias) ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Application ───────────────────────────────────────────────────────────────
# Utilisée dans les e-mails pour construire les liens de retour.
NEXT_PUBLIC_APP_URL=

# ── ML (prédiction budgétaire) ────────────────────────────────────────────────
ML_MODEL_PATH=
PYTHON_PATH=

# ── Assistant de réunion IA : Recall.ai ───────────────────────────────────────
# Clé d'API du workspace Recall. Strictement serveur.
RECALL_API_KEY=
# Secret de vérification des webhooks (commence par whsec_).
# Sans lui, le webhook refuse TOUTES les requêtes : un endpoint public non
# vérifié laisserait piloter l'état des réunions et déclencher des analyses
# facturées.
RECALL_WEBHOOK_SECRET=
# Région du workspace Recall : us-east-1 (défaut), us-west-2, eu-central-1,
# ap-northeast-1. Doit correspondre à la région d'émission de la clé.
RECALL_REGION=us-east-1

# ── Assistant de réunion IA : OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=
# Modèle utilisé pour l'analyse des transcriptions. Lu à chaque appel : en
# changer ne demande aucune modification de code.
OPENAI_MODEL=gpt-5.6-luna
